{#
  A paperback cover. Uses the uploaded image when there is one;
  otherwise draws a classic three-band cover in the story's color.
  size: "lg" (featured), "md" (story page), "sm" (cards)
#}
{% macro cover(title, image, color, size="md", topLabel="", bottomLabel="", alt="") %}
{% set ink = color | inkOn %}
{% if image %}
<span class="cover cover--{{ size }} cover--image">
  <img src="{{ image }}" alt="{{ alt or ('Cover of ' + title) }}" sizes="{% if size == 'sm' %}120px{% else %}(max-width: 600px) 80vw, 380px{% endif %}">
</span>
{% else %}
<span class="cover cover--{{ size }} cover--drawn" style="--band: {{ color }}; --band-ink: {{ ink }}" {% if alt %}role="img" aria-label="{{ alt }}"{% endif %}>
  <span class="cover__band cover__band--top">{% if topLabel and size != 'sm' %}<span class="cover__pill">{{ topLabel }}</span>{% endif %}</span>
  <span class="cover__middle">
    {% if size != 'sm' %}<span class="cover__author">Oliver Atwood</span>{% endif %}
    <span class="cover__title">{{ title }}</span>
    {% if size != 'sm' %}<span class="cover__rule"></span>{% endif %}
  </span>
  <span class="cover__band cover__band--bottom">{% if bottomLabel and size != 'sm' %}<span class="cover__foot">{{ bottomLabel }}</span>{% endif %}</span>
</span>
{% endif %}
{% endmacro %}

{# One book on the shelf: a serial part, a short story, or a poem (thin). #}
{% macro spine(url, label, color, tilt=false, hover="", thin=false) %}
<a class="spine{% if tilt %} spine--tilt{% endif %}{% if thin %} spine--thin{% endif %}" href="{{ url }}"
   style="--spine: {{ color }}; --spine-ink: {{ color | inkOn }}; height: {{ (url | spineHeight) - (40 if thin else 0) }}px"
   title="{{ hover or label }}">
  <span class="spine__text">{{ label }}</span>
</a>
{% endmacro %}

{# Small "About: Story" chip linking a blog post to the serial it discusses. #}
{% macro aboutChip(story, stories) %}
{% if story %}
<a class="about-chip" href="{{ story.url }}">
  {{ cover(story.data.title, story.data.cover, story | spineColor(stories), "sm", alt="") }}
  <span><span class="about-chip__label">About</span> {{ story.data.title }}</span>
</a>
{% endif %}
{% endmacro %}
